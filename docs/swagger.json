        "type": "object",
        "required": [
          "prenom",
          "nom",
          "email",
          "telephone",
          "type"
        ],
        "properties": {
          "prenom": {
            "type": "string",
            "example": "Awa"
          },
          "nom": {
            "type": "string",
            "example": "Diop"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "awa.diop@example.com"
          },
          "telephone": {
            "type": "string",
            "example": "+221770000000"
          },
          "type": {
            "$ref": "#/components/schemas/TypeClient"
          }
        }
      },
      "CreatePrestataireRequest": {
        "type": "object",
        "required": [
          "nom",
          "type",
          "email",
          "telephone"
        ],
        "properties": {
          "nom": {
            "type": "string",
            "example": "DJ Sunset"
          },
          "type": {
            "$ref": "#/components/schemas/TypePrestataire"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "contact@djsunset.com"
          },
          "telephone": {
            "type": "string",
            "example": "+221780000000"
          }
        }
      },
