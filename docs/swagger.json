    "schemas": {
      "TypeClient": {
        "type": "string",
        "enum": [
          "PARTICULIER",
          "ENTREPRISE"
        ]
      },
      "TypePrestataire": {
        "type": "string",
        "enum": [
          "TRAITEUR",
          "DJ",
          "PHOTOGRAPHE",
          "DECORATEUR"
        ]
      },
      "TypeEspace": {
        "type": "string",
        "enum": [
          "SALLE_DE_CONFERENCE",
          "JARDIN",
          "ROOFTOP",
          "SALLE_DE_FETE"
        ]
      },
      "StatutReservation": {
        "type": "string",
        "enum": [
          "CONFIRMEE",
          "ANNULEE",
          "TERMINEE"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "OK"
          },
          "app": {
            "type": "string",
            "example": "EVENT 221 API"
          }
        },
        "required": [
          "status",
          "app"
        ]
      },
      "ValidationDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "email"
          },
          "message": {
            "type": "string",
            "example": "L'email doit etre valide."
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Une erreur est survenue."
          },
          "details": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ValidationDetail"
            }
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "ValidationErrorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ErrorResponse"
          },
          {
            "type": "object",
            "properties": {
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ValidationDetail"
                }
              }
            }
          }
        ]
      },
      "DeleteResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Ressource supprimee avec succes."
          },
          "data": {
            "type": "null",
            "example": null
          }
        },
        "required": [
          "success",
          "message",
          "data"
        ]
      },
      "Client": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "prenom": {
            "type": "string",
            "example": "Awa"
          },
          "nom": {
            "type": "string",
            "example": "Diop"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "awa.diop@example.com"
          },
          "telephone": {
            "type": "string",
            "example": "+221770000000"
          },
          "type": {
            "$ref": "#/components/schemas/TypeClient"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-03T20:15:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-03T20:15:00.000Z"
          }
        },
        "required": [
          "id",
          "prenom",
          "nom",
          "email",
          "telephone",
          "type",
          "createdAt",
          "updatedAt"
        ]
      },
      "Prestataire": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nom": {
            "type": "string",
            "example": "DJ Sunset"
          },
          "type": {
            "$ref": "#/components/schemas/TypePrestataire"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "contact@djsunset.com"
          },
          "telephone": {
            "type": "string",
            "example": "+221780000000"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-03T20:15:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-03T20:15:00.000Z"
          }
        },
        "required": [
          "id",
          "nom",
          "type",
          "email",
          "telephone",
          "createdAt",
          "updatedAt"
        ]
      },
      "Espace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "code": {
            "type": "string",
            "example": "ESP-001"
          },
          "nom": {
            "type": "string",
            "example": "Salle Baobab"
          },
          "capaciteMax": {
            "type": "integer",
            "minimum": 1,
            "example": 250
          },
          "type": {
            "$ref": "#/components/schemas/TypeEspace"
          },
          "prixParJour": {
            "type": "number",
            "format": "float",
            "example": 150000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-03T20:15:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-03T20:15:00.000Z"
          }
        },
        "required": [
          "id",
          "code",
          "nom",
          "capaciteMax",
          "type",
          "prixParJour",
          "createdAt",
          "updatedAt"
        ]
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "clientId": {
            "type": "integer",
            "example": 1
          },
          "espaceId": {
            "type": "integer",
            "example": 1
          },
          "prestataireId": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "dateEvenement": {
            "type": "string",
            "format": "date",
            "example": "2026-05-20"
          },
          "nombreInvites": {
            "type": "integer",
            "minimum": 1,
            "example": 120
          },
          "montantTotal": {
            "type": "number",
            "format": "float",
            "example": 150000
          },
          "statut": {
            "$ref": "#/components/schemas/StatutReservation"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-03T20:15:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-03T20:15:00.000Z"
          },
          "client": {
            "$ref": "#/components/schemas/Client"
          },
          "espace": {
            "$ref": "#/components/schemas/Espace"
          },
          "prestataire": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Prestataire"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "clientId",
          "espaceId",
          "prestataireId",
          "dateEvenement",
          "nombreInvites",
          "montantTotal",
          "statut",
          "createdAt",
          "updatedAt",
          "client",
          "espace",
          "prestataire"
        ]
      },
